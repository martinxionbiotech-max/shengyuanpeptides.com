---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readdirSync, readFileSync } from 'node:fs';
import path from 'node:path';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Knowledge Base — Peptide Research and Procurement Guides',
  description: 'Technical guides on peptide purity, custom synthesis, supplier evaluation, and sourcing from China.',
  url: 'https://shengyuanpeptides.com/knowledge-base/',
};

const KB_DIR = path.join(process.cwd(), 'src/content/kb');
const files = readdirSync(KB_DIR).filter((f) => f.endsWith('.md'));
const articles = files
  .map((f) => {
    const raw = readFileSync(path.join(KB_DIR, f), 'utf8');
    const fm = raw.match(/^---\n([\s\S]*?)\n---/);
    const body = raw.replace(/^---\n[\s\S]*?\n---/, '').trim();
    const meta = {};
    if (fm) {
      for (const line of fm[1].split('\n')) {
        const m = line.match(/^(\w+):\s*(.+)$/);
        if (m) meta[m[1]] = m[2].replace(/^["']|["']$/g, '');
      }
    }
    return { slug: f.replace(/\.md$/, ''), ...meta, body };
  })
  .filter((a) => !a.draft || a.draft === 'false')
  .sort((a, b) => (a.pubDate < b.pubDate ? 1 : -1));

// 主柱子与章节：按 order 排序，其余文章走「全部指南」
const pillar = articles.find((a) => a.pillar === 'peptide-quality-documentation' && String(a.order) === '0');
const cluster = articles
  .filter((a) => a.pillar === 'peptide-quality-documentation' && String(a.order) !== '0')
  .sort((a, b) => Number(a.order) - Number(b.order));
const others = articles.filter((a) => a.pillar !== 'peptide-quality-documentation');

function mdToHtml(md) {
  // minimal markdown: headings, lists, bold, links, code, paragraphs
  const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  let html = md
    .replace(/^#### (.*)$/gm, '<h4>$1</h4>')
    .replace(/^### (.*)$/gm, '<h3>$1</h3>')
    .replace(/^## (.*)$/gm, '<h2>$1</h2>')
    .replace(/^# (.*)$/gm, '<h1>$1</h1>')
    .replace(/^\- (.*)$/gm, '<li>$1</li>')
    .replace(/^\d+\. (.*)$/gm, '<li>$1</li>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .split(/\n\n+/)
    .map((block) => {
      const t = block.trim();
      if (!t) return '';
      if (/^<li>/.test(t)) return `<ul>${t.replace(/<li>/g, '<li>').replace(/<\/li>\n<li>/g, '</li><li>')}</ul>`;
      if (/^<(h[1-4])>/.test(t)) return t;
      if (t.startsWith('|')) {
        const rows = t.split('\n').filter((r) => r.trim() && !/^\|[\s\-|]+\|$/.test(r));
        const cells = (r) => r.replace(/^\||\|$/g, '').split('|').map((c) => c.trim());
        if (!rows.length) return '';
        const head = cells(rows[0]);
        const body = rows.slice(1).map(cells);
        return `<table><thead><tr>${head.map((c) => `<th>${c}</th>`).join('')}</tr></thead><tbody>${body.map((r) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
      }
      return `<p>${t.replace(/\n/g, ' ')}</p>`;
    })
    .join('\n');
  return html;
}
---


<BaseLayout
  jsonLd={jsonLd}
  title="Knowledge Base | Shandong Shengyuan Peptide"
  description="Technical guides on peptide purity, custom synthesis, and sourcing research peptides from China — written by the Shandong Shengyuan Peptide team."
>
  <div class="wrap">
    <h1>Knowledge Base</h1>
    <p class="lede">Technical guides for researchers and buyers, written by our laboratory and quality teams.</p>

    {pillar && (
      <section style="margin:2rem 0 2.5rem;">
        <a class="card" href={`/knowledge-base/${pillar.slug}/`} style="display:block;border-color:rgba(0,0,0,.25);">
          <span class="badge">Pillar guide</span>
          <strong class="card-title" style="font-size:1.15rem;">{pillar.title}</strong>
          <span class="meta">{pillar.description}</span>
          <span class="faint">Start here · {cluster.length} chapters</span>
        </a>
        {cluster.length > 0 && (
          <ol style="margin:1rem 0 0 1.2rem;line-height:1.8;">
            {cluster.map((a) => (
              <li>
                <a href={`/knowledge-base/${a.slug}/`}>{a.title}</a>
                {a.order ? <span class="faint"> — chapter {a.order}</span> : null}
              </li>
            ))}
          </ol>
        )}
      </section>
    )}

    <h2>All guides</h2>
    <div class="grid">
      {others.map((a) => (
        <a class="card" href={`/knowledge-base/${a.slug}/`}>
          <span class="badge">Guide</span>
          <strong class="card-title">{a.title}</strong>
          <span class="meta">{a.description}</span>
          <span class="faint">{a.pubDate}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
