---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${site.company}`,
  description: 'Share your sequence, quantity, and modification needs — a technical quotation usually follows within one business day.',
};
---

<BaseLayout
  title={`Contact Us | ${site.company}`}
  description="Contact Shandong Shengyuan Peptide Technology Co., Ltd. for custom peptide synthesis quotes, OEM projects, COA requests, and technical questions."
  jsonLd={jsonLd}
>
  <div class="wrap">
    <h1>Talk to a Peptide Specialist</h1>
    <p class="lede">
      Share your sequence, quantity, and modification needs — a technical quotation usually
      follows within one business day.
    </p>

    <div class="contact-grid">
      <div>
        <h2>Company Details</h2>
        <table>
          <tbody>
            <tr><th>Company</th><td>{site.company}</td></tr>
            <tr><th>Location</th><td>{site.location}</td></tr>
            <tr><th>Email</th><td><a href="mailto:aaron@shengyuanpeptides.com">aaron@shengyuanpeptides.com</a></td></tr>
            <tr><th>WhatsApp</th><td><a href="https://wa.me/642102668969" target="_blank" rel="noopener">+64 2102668969 — chat now</a></td></tr>
            <tr><th>Founded</th><td>{site.founded}</td></tr>
            <tr><th>Service area</th><td>50+ countries &amp; regions worldwide</td></tr>
          </tbody>
        </table>

        <h3>What to include in your inquiry</h3>
        <ul>
          <li>Sequence or catalog product name</li>
          <li>Required quantity and purity grade</li>
          <li>Modifications (labels, cyclization, PEGylation, etc.)</li>
          <li>Packaging preferences (vial size, private label)</li>
          <li>Target delivery date</li>
        </ul>

        <div class="disclaimer">
          <strong>Research use only.</strong> We supply peptides for laboratory research and
          development. Inquiries regarding human or veterinary use cannot be supported.
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-grid {
    max-width: 720px;
    margin-top: 1.2rem;
  }

</style>
