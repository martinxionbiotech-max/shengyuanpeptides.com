---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${site.company}`,
  description: 'Send your sequence, scale, and modification requirements. Our team replies with a technical quote — usually within 24 hours.',
};
---

<BaseLayout
  title={`Contact Us | ${site.company}`}
  description="Contact Shandong Shengyuan Peptide Technology Co., Ltd. for custom peptide synthesis quotes, OEM projects, COA requests, and technical questions."
  jsonLd={jsonLd}
>
  <div class="wrap">
    <h1>Talk to a Peptide Specialist</h1>
    <p class="lede">
      Send us your sequence, scale, and modification requirements. Our team replies with a technical
      quote — usually within 24 hours.
    </p>

    <div class="contact-grid">
      <form class="contact-form" method="get" action="mailto:sales@shengyuanpeptides.com">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />

        <label for="subject">Subject</label>
        <select id="subject" name="subject">
          <option>Custom peptide synthesis quote</option>
          <option>OEM / private label inquiry</option>
          <option>COA / documentation request</option>
          <option>Product availability</option>
          <option>Partnership proposal</option>
        </select>

        <label for="message">Message</label>
        <textarea id="message" name="body" rows="6" placeholder="Include sequence, quantity, purity grade, modifications, and target date."></textarea>

        <button class="btn" type="submit">Send Inquiry</button>
        <p class="faint">Form opens your email client addressed to {site.email}.</p>
      </form>

      <div>
        <h2>Company Details</h2>
        <table>
          <tbody>
            <tr><th>Company</th><td>{site.company}</td></tr>
            <tr><th>Location</th><td>{site.location}</td></tr>
            <tr><th>Email</th><td><a href="mailto:{site.email}">{site.email}</a></td></tr>
            <tr><th>Founded</th><td>{site.founded}</td></tr>
            <tr><th>Service area</th><td>50+ countries &amp; regions worldwide</td></tr>
          </tbody>
        </table>

        <h3>What to include in your inquiry</h3>
        <ul>
          <li>Sequence or catalog product name</li>
          <li>Required quantity and purity grade</li>
          <li>Modifications (labels, cyclization, PEGylation, etc.)</li>
          <li>Packaging preferences (vial size, private label)</li>
          <li>Target delivery date</li>
        </ul>

        <div class="disclaimer">
          <strong>Research use only.</strong> We supply peptides for laboratory research and
          development. Inquiries regarding human or veterinary use cannot be supported.
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(280px, 1.1fr) minmax(260px, 0.9fr);
    gap: 2rem;
    align-items: start;
    margin-top: 1.2rem;
  }
  .contact-form {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .contact-form label { font-weight: 650; font-size: 0.9rem; margin-top: 0.4rem; }
  .contact-form input, .contact-form select, .contact-form textarea {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-family: inherit;
    background: var(--bg);
  }
  .contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .contact-form .btn { margin-top: 1rem; align-self: flex-start; }
  @media (max-width: 760px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
