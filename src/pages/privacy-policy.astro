---
import BaseLayout from '../layouts/BaseLayout.astro';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy',
  description: 'Privacy policy of shengyuanpeptides.com',
};

---

<BaseLayout
  jsonLd={jsonLd}
  title="Privacy Policy | Shandong Shengyuan Peptide"
  description="Privacy policy of shengyuanpeptides.com — what data we collect, how it is used, and your rights."
>
  <div class="wrap article-shell">
    <div class="article-header">
      <h1>Privacy Policy</h1>
      <p class="lede">Last updated: October 2026</p>
    </div>
    <article>
      <h2>Information We Collect</h2>
      <p>
        When you contact us through the site, we collect the information you submit: your name, email
        address, and the contents of your inquiry. We do not sell personal data to third parties.
      </p>
      <h2>How We Use It</h2>
      <ul>
        <li>To respond to quotes, COA requests, and technical questions</li>
        <li>To manage orders and provide after-sales support</li>
        <li>To improve our website and services</li>
      </ul>
      <h2>Cookies and Analytics</h2>
      <p>
        This website does not run advertising trackers. Where analytics are used, they are limited to
        aggregate, non-identifying usage statistics.
      </p>
      <h2>Data Retention</h2>
      <p>
        Inquiry and order records are retained for the duration of the business relationship and as
        required for accounting and regulatory purposes, then deleted.
      </p>
      <h2>Your Rights</h2>
      <p>
        You may request access to, correction of, or deletion of your personal data at any time by
        writing to sales@shengyuanpeptides.com.
      </p>
      <h2>Contact</h2>
      <p>
        Shandong Shengyuan Peptide Technology Co., Ltd. — Shandong Province, China.
        Email: <a href="mailto:sales@shengyuanpeptides.com">sales@shengyuanpeptides.com</a>
      </p>
    </article>
  </div>
</BaseLayout>
