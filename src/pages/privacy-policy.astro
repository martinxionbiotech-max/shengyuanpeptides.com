---
import BaseLayout from '../layouts/BaseLayout.astro';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy',
  description: 'Privacy policy of shengyuanpeptides.com — what information we receive, how it is used, and your rights.',
};

---

<BaseLayout
  jsonLd={jsonLd}
  title="Privacy Policy | Shengyuan Peptide"
  description="Privacy policy of shengyuanpeptides.com — what information we receive, how it is used, tracking disclosure, data retention, and your rights."
>
  <div class="wrap article-shell">
    <div class="article-header">
      <h1>Privacy Policy</h1>
      <p class="lede">Last updated: October 2026</p>
    </div>
    <article>
      <h2>Who We Are</h2>
      <p>
        This policy describes how <strong>Shandong Shengyuan Peptide Technology Co., Ltd.</strong>
        ("we", "our") handles information in connection with shengyuanpeptides.com, a B2B platform for
        research peptides manufactured in Shandong, China.
      </p>
      <ul>
        <li><strong>Website:</strong> shengyuanpeptides.com</li>
        <li><strong>Email:</strong> <a href="mailto:aaron@shengyuanpeptides.com">aaron@shengyuanpeptides.com</a></li>
        <li><strong>WhatsApp:</strong> +64 2102668969</li>
        <li><strong>Location:</strong> Shandong Province, China</li>
      </ul>

      <h2>Information We Receive</h2>
      <p>
        We operate without account registration and without tracking. The only information we receive
        is what you choose to send us through our contact channels:
      </p>
      <ul>
        <li><strong>Contact details you provide</strong> — your name, email address, or WhatsApp number when you write to us</li>
        <li><strong>Message content</strong> — inquiries, quotation requests, specifications you ask about, and any documents you attach</li>
        <li><strong>Order information</strong> — recipient details and delivery address submitted with a confirmed order, used solely to process and ship that order</li>
      </ul>
      <p>
        We do not collect payment card data. Payment instructions are handled through the methods
        stated on the invoice or quotation.
      </p>

      <h2>Cookies and Tracking</h2>
      <p>
        <strong>This website does not use tracking cookies, analytics scripts, advertising pixels, or
        third-party trackers.</strong> There is no cookie banner because there are no cookies to
        declare. If this changes in the future, this policy will be updated before any tracking is
        introduced.
      </p>

      <h2>How We Use Information</h2>
      <p>Information you send us is used only to:</p>
      <ul>
        <li>Respond to inquiries, quotation requests, COA requests, and technical questions</li>
        <li>Process and confirm orders, verify stock with production, and arrange delivery</li>
        <li>Handle shipping, reshipment, and resolution issues on confirmed orders</li>
        <li>Keep records required for order fulfillment and dispute handling</li>
      </ul>
      <p>
        We do not sell, rent, or trade your information, and we do not use it for marketing mailing
        lists.
      </p>

      <h2>Information Sharing</h2>
      <p>Information is shared only where necessary to fulfill a confirmed order:</p>
      <ul>
        <li><strong>Logistics providers</strong> — to ship parcels to the address you provide</li>
        <li><strong>Manufacturing and QC partners</strong> — to the extent needed for production and batch documentation of your order</li>
      </ul>
      <p>These recipients receive only the order-level information needed for their part in fulfillment.</p>

      <h2>Data Retention</h2>
      <p>
        Inquiry and order records are retained for the duration of the business relationship and for
        as long as reasonably needed for accounting, warranty, and regulatory purposes, then deleted.
        Inquiries that do not lead to an order are kept for a shorter period.
      </p>

      <h2>Your Rights</h2>
      <p>You may contact us at any time to:</p>
      <ul>
        <li>Request a copy of the information we hold about you</li>
        <li>Ask for corrections</li>
        <li>Request deletion of your personal information</li>
      </ul>
      <p>
        We honor these requests subject to obligations to retain records for confirmed orders and
        legal compliance.
      </p>

      <h2>International Transfers</h2>
      <p>
        Our business operates across borders: correspondence is handled from our contact channels, and
        logistics partners are located in China and destination countries. By submitting information,
        you acknowledge that it may be transferred to the parties necessary for order fulfillment.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        We may update this policy. The "Last updated" date reflects the current version. Material
        changes will be stated here.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy: <a href="mailto:aaron@shengyuanpeptides.com">aaron@shengyuanpeptides.com</a>
        or WhatsApp +64 2102668969.
      </p>
    </article>
  </div>
</BaseLayout>
