---
import BaseLayout from '../layouts/BaseLayout.astro';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Terms of Service',
  description: 'Terms governing use of shengyuanpeptides.com and purchase of research peptides from Shandong Shengyuan Peptide Technology Co., Ltd.',
