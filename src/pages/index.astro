---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import services from '../data/services.json';
import faq from '../data/faq.json';
import products from '../data/products.json';

const featuredSlugs = ['retatrutide', 'tirzepatide', 'bpc157', 'tb-500', 'ghk-cu', 'nad', 'ipamorelin', 'selank'];
const featured = featuredSlugs
  .map((s) => products.find((p) => p.slug === s))
  .filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.company,
  url: site.site,
  description:
    'Shandong Shengyuan Peptide Technology Co., Ltd. delivers GMP-certified custom peptide synthesis, OEM private label services, COA verification, and global logistics to research institutions worldwide.',
  email: site.email,
  address: { '@type': 'PostalAddress', addressRegion: 'Shandong', addressCountry: 'CN' },
  foundingDate: '2003',
};
---

<BaseLayout
  title="Shandong Shengyuan Peptide Technology Co., Ltd. | Custom Peptide Synthesis & OEM Manufacturer"
  description="GMP-certified custom peptide synthesis with ≥99% HPLC purity, OEM private label services, batch COA verification, and global logistics. Shandong Shengyuan Peptide Technology Co., Ltd. — serving 500+ research institutions since 2003."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <div class="wrap">
    <section class="hero">
      <div>
        <p style="color:#6ee7b7; font-weight:700; letter-spacing:0.22em; font-size:0.78rem; text-transform:uppercase; margin-bottom:0.6rem;">{site.tagline}</p>
        <h1>Precision. Purity. Performance.</h1>
        <p class="hero-lede">
          For more than two decades, Shandong Shengyuan Peptide Technology Co., Ltd. has delivered
          high-purity custom peptides to 500+ research institutions, pharmaceutical companies, and
          OEM partners — every batch released with a complete Certificate of Analysis.
        </p>
        <div class="hero-badges">
          <span>GMP Certified</span>
          <span>ISO 9001 · ICH Compliant</span>
          <span>Trusted by leading institutions worldwide</span>
        </div>
        <div class="hero-actions">
          <a class="btn" href="/products/">Browse Product Catalog</a>
          <a class="btn btn-ghost" href="/contact/">Request a Quote</a>
        </div>
      </div>
      <div class="hero-art">
        <img src="/images/hero-bg.webp" alt="Peptide research laboratory visualization at Shandong Shengyuan Peptide" width="1399" height="781" loading="eager" />
      </div>
    </section>

    <!-- Stats -->
    <section class="stat-grid" aria-label="Company statistics">
      {site.stats.map((s) => (
        <div class="stat">
          <div class="stat-icon teal" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        </div>
      ))}
    </section>

    <!-- Core services -->
    <section>
      <div class="section-head">
        <h2>Core Products &amp; Services</h2>
        <p>From peptide synthesis to drug development, from quality testing to compliant manufacturing — we deliver end-to-end professional solutions.</p>
      </div>
      <div class="grid">
        {services.map((svc) => {
          const href = {
            'custom-synthesis': '/custom-peptide-synthesis/',
            'drug-development': '/custom-peptide-synthesis/#what-we-synthesize',
            'bioactivity-testing': '/quality/#the-standard-release-panel',
            'gmp-manufacturing': '/quality/',
            'raw-material-library': '/products/',
            'research-partnership': '/about/',
          }[svc.id] || '/contact/';
          return (
            <a class="card" href={href}>
              <img class="card-thumb" src={`/images/${svc.image}`} alt={svc.title} width="600" height="400" loading="lazy" />
              <span class="badge">{svc.cat}</span>
              <strong class="card-title">{svc.title}</strong>
              <span class="meta">{svc.summary}</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Featured products -->
    <section>
      <div class="section-head">
        <h2>Featured Research Peptides</h2>
        <p>A selection from our catalog of 24 stocked research peptides — all released with batch-specific COA data you can verify online.</p>
      </div>
      <div class="grid">
        {featured.map((p) => (
          <a class="card" href={`/products/#${p.slug}`}>
            <img class="card-thumb" src={`/images/${p.image}`} alt={`${p.name} research peptide`} width="800" height="800" loading="lazy" />
            <span class="badge">{p.purity} purity</span>
            <strong class="card-title">{p.name}</strong>
            <span class="meta">{p.summary}</span>
          </a>
        ))}
      </div>
      <p><a class="btn btn-ghost" href="/products/">View Full Catalog →</a></p>
    </section>

    <!-- COA verification teaser -->
    <section>
      <div class="section-head">
        <h2>Quality You Can Verify</h2>
      </div>
      <div class="notice" style="display:flex; gap:1.2rem; align-items:flex-start;">
        <img src="/images/coa-document.webp" alt="Certificate of Analysis document" width="160" height="210" loading="lazy" style="flex:none; border-radius:8px; border:1px solid var(--border);" />
        <div>
          <p style="margin-bottom:0.6rem;">
            Every batch comes with a complete Certificate of Analysis — HPLC purity, mass spectrometry
            identity, peptide content, water content, and endotoxin — meeting ICH, USP, and other
            international analytical standards.
          </p>
          <p style="margin-bottom:0.9rem;">
            Every product label carries a verification code. Enter it in our online lookup to authenticate
            the batch and view its COA data instantly.
          </p>
          <a class="btn" href="/coa/">Verify a Batch COA</a>
        </div>
      </div>
    </section>

    <!-- About teaser -->
    <section>
      <div class="section-head">
        <h2>About Shandong Shengyuan Peptide</h2>
      </div>
      <p class="lede">
        Founded in 2003, Shandong Shengyuan Peptide Technology Co., Ltd. was built on a single conviction:
        that world-class peptide research demands uncompromising scientific rigor and the most advanced
        synthesis technology available. Today, more than 200 scientists, analysts, and regulatory
        specialists operate our synthesis platform, serving 500+ pharmaceutical companies, universities,
        and research institutes.
      </p>
      <p>
        <a class="btn btn-ghost" href="/about/">Read Our Story →</a>
      </p>
    </section>

    <!-- FAQ teaser -->
    <section>
      <div class="section-head">
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="grid">
        {faq.slice(0, 4).map((f) => (
          <div class="card">
            <strong class="card-title">{f.q}</strong>
            <span class="meta">{f.a}</span>
          </div>
        ))}
      </div>
      <p><a class="btn btn-ghost" href="/faq/">All Questions →</a></p>
    </section>
  </div>
</BaseLayout>
