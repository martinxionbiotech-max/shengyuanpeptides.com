---
import BaseLayout from '../layouts/BaseLayout.astro';
import coa from '../data/coa.json';
import products from '../data/products.json';

const slugByName = Object.fromEntries(products.map((p) => [p.name.toLowerCase(), p.slug]));

// 证书上会出现的字段——只描述结构，不给任何具体批次的数值
const FIELDS: [string, string][] = [
  ['Product / batch', 'Product name and the batch number printed on the vial label'],
  ['CAS number', 'Chemical Abstracts Service registry number'],
  ['Appearance', 'Physical description of the lyophilised powder'],
  ['Purity (HPLC)', 'Area percentage by reverse-phase HPLC at the stated wavelength'],
  ['Mass (MS)', 'Observed molecular mass against the calculated mass'],
  ['Peptide content', 'Net peptide content of the vial, by nitrogen or UV assay'],
  ['Water content', 'Karl Fischer titration result'],
  ['pH', 'pH of the reconstituted solution'],
  ['Endotoxin', 'LAL result in EU/mg'],
  ['Sequence', 'Full amino-acid sequence for the batch'],
  ['Manufacture / retest date', 'Date of manufacture and the retest interval'],
  ['Storage', 'Temperature and light conditions for storage and transport'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Certificates of Analysis — Shandong Shengyuan Peptide',
  description:
    'What a Shengyuan peptide Certificate of Analysis contains, and how to request the certificate for a specific batch.',
};
---

<BaseLayout
  title="Certificates of Analysis (COA) | Shengyuan Peptide"
  description="Every batch ships with a Certificate of Analysis. See what the certificate records and how to request the COA for your specific batch."
  jsonLd={jsonLd}
>
  <div class="wrap">
    <h1>Certificates of Analysis</h1>
    <p class="lede">
      Every batch we release is accompanied by its own Certificate of Analysis — purity, identity,
      water content, endotoxin and the method used. The certificate is issued per batch, not per
      product, so it travels with your order rather than sitting on a web page where the figures
      would not match the vial in your hand.
    </p>

    <div class="notice">
      <strong>How to get the COA for your batch.</strong> Email
      <a href="mailto:aaron@shengyuanpeptides.com">aaron@shengyuanpeptides.com</a> with the batch
      number from the vial label, or ask for it when you request a quotation. We send the signed PDF
      for that batch; a third-party laboratory report can be arranged on request, at your cost.
    </div>

    <h2>What the certificate records</h2>
    <p>
      This is the structure of our COA. The values are specific to the batch being released, which is
      why they are not reproduced on this page.
    </p>
    <table>
      <thead>
        <tr><th>Field</th><th>What it records</th></tr>
      </thead>
      <tbody>
        {FIELDS.map(([field, meaning]) => (
          <tr><td><strong>{field}</strong></td><td>{meaning}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>Products released with a batch certificate</h2>
    <p class="faint">
      Every stocked product below ships with a batch-specific COA. Custom synthesis runs are
      documented the same way, with the analytical record for that run.
    </p>
    <table>
      <thead>
        <tr><th>Product</th><th>CAS</th><th>Certificate</th></tr>
      </thead>
      <tbody>
        {coa.map((c) => {
          const slug = slugByName[c.product.toLowerCase()];
          return (
            <tr>
              <td>{slug ? <a href={`/products/${slug}/`}>{c.product}</a> : c.product}</td>
              <td>{c.cas}</td>
              <td>Per batch — supplied with the order</td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <div class="notice">
      <strong>Independent testing.</strong> If your process requires a report from a laboratory you
      nominate, tell us before the batch is released and we will arrange sampling and shipment to
      that laboratory.
    </div>

    <p class="faint">
      There is no online certificate lookup on this site. A code that only checks against the same
      website proves that the website agrees with itself, not that a batch was tested — so the
      document we send is the signed certificate, and the laboratory it names can be contacted
      directly.
    </p>
  </div>
</BaseLayout>
